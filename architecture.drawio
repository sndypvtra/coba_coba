        <mxCell id="striplbl" value="INSIDE THE INFERENCE SERVER" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8F96;fontStyle=1;letterSpacing=2;" vertex="1" parent="1">
          <mxGeometry x="36" y="616" width="400" height="16" as="geometry" />
        </mxCell>
        <mxCell id="stripnote" value="sample rate is a design lever, not a constant &amp;#8212; halving it roughly doubles the cameras one GPU serves, and makes tracking harder" style="text;html=1;align=right;verticalAlign=middle;fontSize=10;fontColor=#8A8F96;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="460" y="616" width="1104" height="16" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;&lt;font color=&quot;#1F2430&quot;&gt;DECODE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8A8F96&quot;&gt;H.264/H.265 &amp;#8594; frames,&lt;br&gt;hardware decoder&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#5A6570&quot;&gt;video decoder&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D5CE;strokeWidth=1;fontSize=10;align=center;spacing=4;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="36" y="638" width="202" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;&lt;font color=&quot;#1F2430&quot;&gt;SAMPLE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8A8F96&quot;&gt;drop to the rate the&lt;br&gt;task actually needs&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#5A6570&quot;&gt;CPU&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D5CE;strokeWidth=1;fontSize=10;align=center;spacing=4;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="256" y="638" width="202" height="76" as="geometry" />
        </mxCell>
        <mxCell id="pa1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;jettySize=auto;strokeColor=#B9B9AF;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;" edge="1" parent="1" source="p1" target="p2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;&lt;font color=&quot;#C2410C&quot;&gt;INFER&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B07A55&quot;&gt;the detector, as a&lt;br&gt;TensorRT engine&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#C2410C&quot;&gt;GPU&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCF2E8;strokeColor=#C2410C;strokeWidth=2;fontSize=10;align=center;spacing=4;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="476" y="638" width="202" height="76" as="geometry" />
        </mxCell>
        <mxCell id="pa2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;jettySize=auto;strokeColor=#B9B9AF;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;" edge="1" parent="1" source="p2" target="p3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;&lt;font color=&quot;#1F2430&quot;&gt;TRACK&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8A8F96&quot;&gt;one identity per object&lt;br&gt;across frames&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#5A6570&quot;&gt;CPU&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D5CE;strokeWidth=1;fontSize=10;align=center;spacing=4;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="696" y="638" width="202" height="76" as="geometry" />
        </mxCell>
        <mxCell id="pa3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;jettySize=auto;strokeColor=#B9B9AF;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;" edge="1" parent="1" source="p3" target="p4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="&lt;b&gt;&lt;font color=&quot;#1F2430&quot;&gt;LOGIC&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8A8F96&quot;&gt;zones, dwell, counting&lt;br&gt;&amp;#8212; the domain part&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#5A6570&quot;&gt;CPU&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D5CE;strokeWidth=1;fontSize=10;align=center;spacing=4;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="916" y="638" width="202" height="76" as="geometry" />
        </mxCell>
        <mxCell id="pa4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;jettySize=auto;strokeColor=#B9B9AF;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;" edge="1" parent="1" source="p4" target="p5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="&lt;b&gt;&lt;font color=&quot;#2E7D5B&quot;&gt;ANNOTATE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5D8F76&quot;&gt;boxes drawn for&lt;br&gt;the live view&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#2E7D5B&quot;&gt;GPU &amp;#8594; HDMI&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF7F2;strokeColor=#2E7D5B;strokeWidth=2;fontSize=10;align=center;spacing=4;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1136" y="638" width="202" height="76" as="geometry" />
        </mxCell>
        <mxCell id="pa5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;jettySize=auto;strokeColor=#B9B9AF;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;" edge="1" parent="1" source="p5" target="p6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7" value="&lt;b&gt;&lt;font color=&quot;#1F2430&quot;&gt;EVENTS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8A8F96&quot;&gt;structured records,&lt;br&gt;queued for upload&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#5A6570&quot;&gt;CPU&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D5CE;strokeWidth=1;fontSize=10;align=center;spacing=4;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1356" y="638" width="202" height="76" as="geometry" />
        </mxCell>
        <mxCell id="pa6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;jettySize=auto;strokeColor=#B9B9AF;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;" edge="1" parent="1" source="p6" target="p7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="footrule" value="" style="line;strokeWidth=1;html=1;strokeColor=#D5D5CE;" vertex="1" parent="1">
          <mxGeometry x="36" y="730" width="1528" height="8" as="geometry" />
        </mxCell>
        <mxCell id="foot1" value="&lt;b&gt;Sizing&lt;/b&gt;&amp;#160;&amp;#160;1&amp;#8211;4 cameras: embedded GPU module, fanless &amp;#183; 4&amp;#8211;16: small-form-factor x86 + one workstation GPU &amp;#183; 16+: 1U/2U rack server. The board is a procurement decision, not an architecture one." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#5A6570;" vertex="1" parent="1">
          <mxGeometry x="36" y="744" width="1528" height="16" as="geometry" />
        </mxCell>
        <mxCell id="foot2" value="&lt;b&gt;Watching it live&lt;/b&gt;&amp;#160;&amp;#160;three ways, not alternatives &amp;#8212; &lt;font color=&quot;#2E7D5B&quot;&gt;&lt;b&gt;A&lt;/b&gt; direct HDMI, tens of ms, nearly free&lt;/font&gt; &amp;#183; &lt;b&gt;B&lt;/b&gt; re-stream RTSP/WebRTC, 0.2&amp;#8211;2 s, costs one encode per stream &amp;#8212; budget for it &amp;#183; &lt;b&gt;C&lt;/b&gt; dashboard, numbers only. A and B stay inside the boundary; only C crosses it." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#5A6570;" vertex="1" parent="1">
          <mxGeometry x="36" y="762" width="1528" height="16" as="geometry" />
        </mxCell>
        <mxCell id="foot3" value="&lt;b&gt;Read the limits&lt;/b&gt;&amp;#160;&amp;#160;counting is a detection result and duration is a tracking result &amp;#8212; they are not equally reliable, and a quality score rides with every subject. Interpolated frames are stored apart from observed ones. No faces, no re-identification across sites. Calibration belongs to one camera position." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8F96;" vertex="1" parent="1">
          <mxGeometry x="36" y="780" width="1528" height="16" as="geometry" />
        </mxCell>
        <mxCell id="foot4" value="Throughput figures belong on a benchmark, not on an architecture diagram: an engine is built for one GPU, one precision and one input size, and &lt;i&gt;trtexec&lt;/i&gt; on the target board is what gives the number." style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontColor=#A0A5AC;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="36" y="798" width="1528" height="14" as="geometry" />
        </mxCell>
        <mxCell id="credit" value="Icons: Material Design Icons &amp;#183; Google Material Symbols &amp;#183; IBM Carbon (all Apache-2.0), served by api.iconify.design and embedded in this file. PostgreSQL, Grafana and NVIDIA marks belong to their owners." style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontColor=#B4B8BE;" vertex="1" parent="1">
          <mxGeometry x="36" y="816" width="1528" height="14" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
