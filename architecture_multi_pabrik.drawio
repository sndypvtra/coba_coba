        <mxCell id="c241" value="" style="rounded=1;arcSize=2;absoluteArcSize=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1;fontSize=11;fontColor=#374151;align=left;verticalAlign=top;spacing=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="190" y="1618" width="14" height="14" as="geometry"/></mxCell>
        <mxCell id="c242" value="garis putus abu = opsional" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;fontSize=11.5;fontColor=#374151;spacing=0;" vertex="1" parent="1"><mxGeometry x="210" y="1617" width="220" height="18" as="geometry"/></mxCell>
        <mxCell id="c243" value="" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontSize=11;fontColor=#374151;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="780" y="1478" width="1720" height="166" as="geometry"/></mxCell>
        <mxCell id="c244" value="&lt;b&gt;Jika WAN putus:&lt;/b&gt; CV Worker tetap jalan dan rekaman tetap di disk edge; &lt;i&gt;event&lt;/i&gt; ditahan di RabbitMQ lokal (queue durable, dibatasi ukuran disk) lalu dikirim ulang otomatis oleh shovel saat tersambung. &lt;i&gt;track&lt;/i&gt; lama dibuang (TTL), karena hanya berguna untuk overlay live.&lt;br&gt;&lt;b&gt;Port:&lt;/b&gt; RTSP 8554 dan AMQP 5672 hanya lokal di edge; WHEP 8889 + UDP 8189 hanya untuk group:viewer; 443 di pusat. Tidak ada port yang dibuka ke internet, semua lewat Tailscale.&lt;br&gt;&lt;b&gt;Bandwidth WAN:&lt;/b&gt; metadata &amp;#177; puluhan kbps per kamera (tergantung fps dan jumlah objek); video hanya saat ditonton, &amp;#177; 0,5&amp;#8211;2 Mbps per sub-stream per viewer. Angka ini perkiraan, ukur di lokasi.&lt;br&gt;&lt;b&gt;Overlay:&lt;/b&gt; track membawa ts + bbox; browser menggambar kotak di atas video WebRTC dan menyelaraskan lewat ts. Penamaan stream: &amp;lt;site&amp;gt;_camNN (main) dan &amp;lt;site&amp;gt;_camNN_sub (untuk AI dan viewer).&lt;br&gt;&lt;b&gt;Keamanan:&lt;/b&gt; kamera di VLAN sendiri dan hanya bisa dibaca edge node; user hanya melihat pabrik sesuai haknya (ACL Tailscale + role di FastAPI)." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;fontSize=13;fontColor=#374151;spacing=0;" vertex="1" parent="1"><mxGeometry x="796" y="1490" width="1690" height="124" as="geometry"/></mxCell>
        <mxCell id="c245" value="Logo &amp;amp; ikon: Iconify (logos, Simple Icons CC0, MDI, Material Symbols), draw.io clip art (Apache 2.0), MediaMTX (bluenviron). Logo adalah merek dagang pemiliknya." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;fontSize=10.5;fontColor=#9CA3AF;spacing=0;" vertex="1" parent="1"><mxGeometry x="796" y="1622" width="1690" height="16" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
