        <mxCell id="c156" value="&lt;b&gt;PABRIK C, D, &amp;#8230;&lt;/b&gt; &amp;#8212; polanya sama: Kamera IP &amp;#8594; Edge Node (MediaMTX &amp;#183; CV Worker &amp;#183; RabbitMQ lokal &amp;#183; Tailscale) &amp;#183; MagicDNS &lt;b&gt;edge-pabrik-c&lt;/b&gt;&lt;br&gt;Tambah pabrik = 1 edge node + kamera + join tailnet (tag:edge) + 1 shovel + 1 baris di tabel &lt;i&gt;site&lt;/i&gt;. Server pusat tidak berubah." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;fontSize=13;fontColor=#6B7280;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="1372" width="1160" height="60" as="geometry"/></mxCell>
        <mxCell id="c157" value="&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;TAILNET&lt;/b&gt;&lt;br&gt;WireGuard, terenkripsi end-to-end&lt;br&gt;MagicDNS: edge-pabrik-a,&lt;br&gt;edge-pabrik-b, pusat&lt;br&gt;&lt;font color=&#x27;#6B7280&#x27;&gt;login user: SSO + MFA&lt;/font&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1;fontSize=12;fontColor=#374151;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1280" y="200" width="175" height="190" as="geometry"/></mxCell>
