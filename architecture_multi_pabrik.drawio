        <mxCell id="c196" value="&lt;b&gt;PABRIK C, D, &amp;#8230;&lt;/b&gt; &amp;#8212; polanya sama: Kamera IP &amp;#8594; Server Pabrik (MediaMTX &amp;#183; CV Worker &amp;#183; RabbitMQ &amp;#183; FastAPI &amp;#183; PostgreSQL &amp;#183; Webapp &amp;#183; Tailscale) &amp;#183; MagicDNS &lt;b&gt;server-pabrik-c&lt;/b&gt;&lt;br&gt;Tambah pabrik = 1 server + kamera + join tailnet (tag:pabrik) + 1 bookmark baru di laptop. Server pabrik lain tidak berubah." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;fontSize=13;fontColor=#6B7280;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="1372" width="1720" height="60" as="geometry"/></mxCell>
        <mxCell id="c197" value="&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;TAILNET&lt;/b&gt; (WireGuard, terenkripsi end-to-end)&lt;br&gt;MagicDNS: server-pabrik-a, server-pabrik-b&lt;br&gt;&lt;font color=&#x27;#6B7280&#x27;&gt;login user: SSO + MFA&lt;br&gt;device harus di-approve admin&lt;/font&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1;fontSize=12;fontColor=#374151;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1820" y="200" width="270" height="190" as="geometry"/></mxCell>
        <mxCell id="c198" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1832" y="210" width="36" height="36" as="geometry"/></mxCell>
        <mxCell id="c199" value="&lt;b&gt;&lt;font color=&#x27;#DC2626&#x27;&gt;Tanpa server pusat&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Laptop tersambung langsung ke server tiap pabrik (P2P lewat Tailscale). Data tiap pabrik tetap di server pabriknya.&lt;br&gt;&lt;br&gt;Video hanya mengalir saat ada yang menonton." style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1;fontSize=12;fontColor=#374151;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1820" y="410" width="270" height="172" as="geometry"/></mxCell>
        <mxCell id="c200" value="&lt;b&gt;ACL (policy file)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&#x27;Courier New&#x27;&gt;group:viewer&lt;br&gt;&amp;#8594; tag:pabrik :443&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#6B7280&#x27;&gt;webapp, API, WebSocket&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&#x27;Courier New&#x27;&gt;group:viewer&lt;br&gt;&amp;#8594; tag:pabrik :8889, UDP :8189&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#6B7280&#x27;&gt;video live&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&#x27;Courier New&#x27;&gt;tag:pabrik &amp;#8596; tag:pabrik&lt;br&gt;&amp;#8594; ditolak&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#6B7280&#x27;&gt;server A dan B tidak saling akses&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&#x27;Courier New&#x27;&gt;group:ops &amp;#8594; tag:pabrik :22&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#6B7280&#x27;&gt;maintenance (opsional)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#6B7280&#x27;&gt;Bisa dibatasi per pabrik: group:viewer-a hanya ke server-pabrik-a.&lt;/font&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1;fontSize=12;fontColor=#374151;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1820" y="700" width="270" height="490" as="geometry"/></mxCell>
