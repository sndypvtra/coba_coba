        <mxCell id="c192" value="&lt;b&gt;Tailscale&lt;/b&gt;&lt;br&gt;tailscaled&lt;br&gt;&lt;br&gt;MagicDNS&lt;br&gt;&lt;b&gt;&lt;font color=&#x27;#111827&#x27;&gt;server-pabrik-b&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;tag:pabrik&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#6B7280&#x27;&gt;keluar ke internet:&lt;br&gt;UDP 41641 / TCP 443&lt;br&gt;(outbound saja)&lt;/font&gt;&lt;br&gt;&lt;br&gt;IP tailnet&lt;br&gt;100.x.y.z" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;verticalAlign=top;fontSize=12;fontColor=#374151;spacing=0;" vertex="1" parent="1"><mxGeometry x="1614" y="942" width="137" height="330" as="geometry"/></mxCell>
