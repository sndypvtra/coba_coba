        <mxCell id="c159" value="&lt;b&gt;&lt;font color=&#x27;#DC2626&#x27;&gt;Yang lewat WAN&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;#8226; event/metadata: kecil, terus-menerus&lt;br&gt;&amp;#8226; video: hanya saat ada viewer&lt;br&gt;&lt;br&gt;Video tidak dikirim terus-menerus ke pusat." style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1;fontSize=12;fontColor=#374151;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1280" y="410" width="175" height="170" as="geometry"/></mxCell>
