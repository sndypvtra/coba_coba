# model weights (re-downloaded by scripts/fetch_assets.sh)
weights/
*.pt
mobileclip_blt.ts

# source clips (re-downloaded by scripts/fetch_assets.sh)
videos/

# runtime-resolved tracker configs
output/.*_resolved.yaml

__pycache__/
*.pyc

# rendered result videos - regenerate with the case scripts in cases/
output/*.mp4

# per-variant series from factory_vision/tools/perturbation_test.py; the baseline
# output/liquid_level_summary.json is committed, these are regenerable
output/liquid_level_summary_*.json
output/.depth_cache/

# per-project artefacts
projects/*/input/*
projects/*/output/*.mp4
projects/*/output/.depth_cache/
!projects/*/input/.gitkeep
projects/*/output/.*_resolved.yaml

# Case 5's two clips are the one exception, and they are committed on purpose.
# Every other project's input is fetched on first run - by Pexels id, or from
# HuggingFace for case 6 - so keeping it out of git costs nothing. Case 5's
# source is the CAFE dataset, distributed as a single ~150 GB Google Drive
# archive with no API, which no `main.py` can reasonably pull. Without these
# two 30-second cuts in the repository, `python main.py` fails on a clean
# clone, and that was the one thing the per-project layout was meant to fix.
# 47 MB is the price of the project being runnable.
!projects/05_cafe_dwell_time/input/cafe_scene1_30s.mp4
!projects/05_cafe_dwell_time/input/cafe_scene5_30s.mp4
